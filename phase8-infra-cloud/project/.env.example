# ============================================================
# .env.example
# このファイルは Git に含めます（実際の値は書きません）
# 実際に使う際は .env にコピーして値を設定してください
#   cp .env.example .env
# .env は .gitignore に追加して Git に含めないでください
# ============================================================

# PostgreSQL の接続情報
DATABASE_URL=postgresql://appuser:apppass@db:5432/appdb

# Redis の接続情報
REDIS_URL=redis://cache:6379

# アプリケーションの設定
APP_ENV=development
